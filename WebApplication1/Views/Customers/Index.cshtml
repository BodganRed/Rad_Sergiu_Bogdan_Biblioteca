@model IEnumerable<WebApplication1.Models.Customer>
@{ ViewData["Title"] = "Cititori"; }
<h1>Cititori</h1>
<p><a asp-action="Create">Adaugă cititor nou</a></p>
<table class="table">
    <thead><tr><th>@Html.DisplayNameFor(m => m.Name)</th><th>@Html.DisplayNameFor(m => m.Adress)</th><th>@Html.DisplayNameFor(m => m.BirthDate)</th><th></th></tr></thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(m => item.Name)</td>
            <td>@Html.DisplayFor(m => item.Adress)</td>
            <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CustomerID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CustomerID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CustomerID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
