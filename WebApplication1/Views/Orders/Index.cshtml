@model IEnumerable<WebApplication1.Models.Order>

@{
    ViewData["Title"] = "Comenzi";
    var customerList = ViewData["CustomerList"] as SelectList;
}

<h1>Comenzi</h1>

<p><a asp-action="Create" class="btn btn-primary btn-sm">Comandă nouă</a></p>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Filtrează după cititor:</label>
        <select name="customerId" asp-items="customerList" class="form-select form-select-sm">
            <option value="">Toți cititorii</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filtrează</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cititor</th>
            <th>Carte</th>
            <th>Data comenzii</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Customer?.Name</td>
            <td>@item.Book?.Title</td>
            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrderID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
