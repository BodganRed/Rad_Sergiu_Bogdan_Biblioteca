@model WebApplication1.Models.Order
@{ ViewData["Title"] = "Ștergere comandă"; }
<h1>Ștergere comandă</h1>
<h3>Sigur dorești să ștergi această comandă?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Cititor</dt><dd class="col-sm-10">@Model.Customer?.Name</dd>
        <dt class="col-sm-2">Carte</dt><dd class="col-sm-10">@Model.Book?.Title</dd>
        <dt class="col-sm-2">Data</dt><dd class="col-sm-10">@Model.OrderDate.ToString("yyyy-MM-dd")</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="OrderID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> | <a asp-action="Index">Back to List</a>
    </form>
</div>
