@model WebApplication1.Models.Author

@{
    ViewData["Title"] = "Detalii autor";
    var totalOrders = ViewData["TotalOrders"] as int? ?? 0;
    var mostOrderedBook = ViewData["MostOrderedBook"] as string ?? "Nicio carte comandată";
}

<h1>Detalii autor</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FirstName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FirstName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.LastName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.LastName)</dd>

        <dt class="col-sm-3">Nume complet</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>

        <dt class="col-sm-3">Total comenzi</dt>
        <dd class="col-sm-9">@totalOrders</dd>

        <dt class="col-sm-3">Cea mai comandată carte (V4)</dt>
        <dd class="col-sm-9">@mostOrderedBook</dd>
    </dl>
</div>

<h3>Cărțile autorului</h3>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Titlu</th>
            <th>Gen</th>
            <th>Preț</th>
            <th>Număr de comenzi</th>
        </tr>
    </thead>
    <tbody>
@foreach (var book in Model.Books.OrderBy(b => b.Title))
{
        <tr>
            <td>@book.Title</td>
            <td>@book.Genre?.Name</td>
            <td>@book.Price.ToString("0.00")</td>
            <td>@book.Orders.Count</td>
        </tr>
}
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
