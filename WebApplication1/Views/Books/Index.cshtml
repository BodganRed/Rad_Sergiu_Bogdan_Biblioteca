@model PaginatedList<WebApplication1.Models.BookListItem>

@{
    ViewData["Title"] = "Catalog";
    var currentSort = ViewData["CurrentSort"] as string;
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentPublisher = ViewData["CurrentPublisher"] as string;
    var publishers = ViewBag.Publishers as SelectList;
}

<h1>Catalog</h1>

<p><a asp-action="Create" class="btn btn-primary btn-sm">Carte nouă</a></p>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <input type="hidden" name="sortOrder" value="@currentSort" />
    <div class="col-md-4">
        <label class="form-label">Caută după titlu:</label>
        <input type="text" name="searchString" value="@currentFilter" class="form-control form-control-sm" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Editură (V3):</label>
        <select name="publisher" asp-items="publishers" class="form-select form-select-sm">
            <option value="">Toate</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filtrează / Caută</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Toată lista</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["TitleSortParm"]"
                   asp-route-currentFilter="@currentFilter"
                   asp-route-currentPublisher="@currentPublisher">Titlu</a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["AuthorSortParm"]"
                   asp-route-currentFilter="@currentFilter"
                   asp-route-currentPublisher="@currentPublisher">Autor</a>
            </th>
            <th>Gen</th>
            <th>Editură</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["YearSortParm"]"
                   asp-route-currentFilter="@currentFilter"
                   asp-route-currentPublisher="@currentPublisher">An</a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["PriceSortParm"]"
                   asp-route-currentFilter="@currentFilter"
                   asp-route-currentPublisher="@currentPublisher">Preț</a>
            </th>
            <th>Comenzi</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Genre</td>
            <td>@item.Publishers</td>
            <td>@item.Year</td>
            <td>@item.Price.ToString("0.00")</td>
            <td>@item.Orders</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    var prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    var nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="mt-2">
    <a asp-action="Index"
       asp-route-sortOrder="@currentSort"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@currentFilter"
       asp-route-currentPublisher="@currentPublisher"
       class="btn btn-outline-primary btn-sm @prevDisabled">Înapoi</a>

    <a asp-action="Index"
       asp-route-sortOrder="@currentSort"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@currentFilter"
       asp-route-currentPublisher="@currentPublisher"
       class="btn btn-outline-primary btn-sm @nextDisabled">Înainte</a>

    <span class="ms-2">Pagina @Model.PageIndex din @Model.TotalPages (6 / pagină)</span>
</div>
